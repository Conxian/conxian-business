{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Conxian/conxian-business/blob/main/governance/external-semantic-sources.schema.v1.json",
  "title": "Conxian external semantic source registry",
  "description": "Fail-closed registry for immutable external semantic-source evidence. Registry presence alone is not adoption or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sources"],
  "properties": {
    "$schema": {
      "const": "external-semantic-sources.schema.v1.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "^governance/evidence/external-semantic-sources/" }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "notice"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "notice": { "$ref": "#/$defs/artifact" }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/relativePath" },
        "to": { "$ref": "#/$defs/relativePath" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "tool", "toolVersion", "evidence"],
      "properties": {
        "input": { "$ref": "#/$defs/relativePath" },
        "output": { "$ref": "#/$defs/relativePath" },
        "tool": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repositoryUrl",
        "commitSha",
        "archiveUrl",
        "archiveSha256",
        "observedDate",
        "state",
        "review",
        "selectedFiles",
        "importClosure",
        "notices",
        "extensionNamespace",
        "transformations",
        "sbomHandoff",
        "claims"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": { "enum": ["selected", "adopted"] }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "selectedFiles": { "minItems": 1 },
              "importClosure": {
                "properties": {
                  "status": { "const": "closed" },
                  "evidence": { "$ref": "#/$defs/artifact" }
                }
              },
              "notices": {
                "properties": {
                  "rootLicense": { "$ref": "#/$defs/artifact" },
                  "files": { "minItems": 1 }
                }
              },
              "extensionNamespace": {
                "properties": {
                  "uri": {
                    "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)?(?:conxian\\.io|conxian\\.com)/[^/?#]+"
                  },
                  "owner": { "pattern": "Conxian" }
                }
              },
              "transformations": {
                "properties": {
                  "status": { "enum": ["none", "recorded"] },
                  "evidence": { "$ref": "#/$defs/artifact" }
                }
              },
              "sbomHandoff": {
                "properties": {
                  "status": { "const": "handoff-ready" },
                  "evidence": { "$ref": "#/$defs/artifact" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "research-only" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "enum": ["pending", "approved-for-research"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "candidate" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "enum": ["pending", "approved-for-research"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "selected" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "const": "approved-for-selection" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "adopted" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "const": "approved-for-adoption" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "rejected" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "const": "rejected" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "retired" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "review": {
                "properties": {
                  "disposition": { "const": "retired" }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "$ref": "#/$defs/httpsUrl" },
        "commitSha": { "$ref": "#/$defs/commitSha" },
        "archiveUrl": { "$ref": "#/$defs/httpsUrl" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "observedDate": { "$ref": "#/$defs/date" },
        "state": {
          "enum": ["research-only", "candidate", "selected", "adopted", "rejected", "retired"]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "reference"],
          "properties": {
            "disposition": {
              "enum": [
                "pending",
                "approved-for-research",
                "approved-for-selection",
                "approved-for-adoption",
                "rejected",
                "retired"
              ]
            },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "selectedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "importClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "imports", "evidence"],
          "properties": {
            "status": { "enum": ["not-evaluated", "not-applicable", "closed"] },
            "imports": {
              "type": "array",
              "items": { "$ref": "#/$defs/import" }
            },
            "evidence": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/artifact" }
              ]
            }
          }
        },
        "notices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rootLicense", "files"],
          "properties": {
            "rootLicense": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/artifact" }
              ]
            },
            "files": {
              "type": "array",
              "items": { "$ref": "#/$defs/notice" }
            }
          }
        },
        "extensionNamespace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "owner"],
          "properties": {
            "uri": { "$ref": "#/$defs/httpsUrl" },
            "owner": { "type": "string", "minLength": 1 }
          }
        },
        "transformations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "rationale", "records", "evidence"],
          "properties": {
            "status": { "enum": ["not-evaluated", "none", "recorded"] },
            "rationale": { "type": "string", "minLength": 1 },
            "records": {
              "type": "array",
              "items": { "$ref": "#/$defs/transformation" }
            },
            "evidence": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/artifact" }
              ]
            }
          }
        },
        "sbomHandoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": { "enum": ["not-ready", "handoff-ready"] },
            "evidence": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/artifact" }
              ]
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "notSupported"],
          "properties": {
            "supported": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "notSupported": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
