# Environment variables for the root docker-compose reference stack (local simulation lane).
#
# Uses local mock/regtest nodes for development.
# No public network access required.
#
# Copy this file to `.env` (never commit `.env`):
#
#   cp docker-compose.env.local.example .env
#
# For RPC options see docker-compose.env.example (the comprehensive reference).

# Shared
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_NAME=nexus

# Nexus (local stacks mocknet)
STACKS_NODE_RPC_URL=http://host.docker.internal:3999
NEXUS_EXPERIMENTAL_APIS=0
NEXUS_ORACLE_ENABLED=0
NEXUS_ORACLE_STUB_OK=0

# Gateway (local bitcoind regtest + stacks mocknet)
BITCOIN_RPC_URL=http://host.docker.internal:18443
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=
STACKS_RPC_URL=http://host.docker.internal:3999

API_TOKEN=dev_api_token
FIAT_WEBHOOK_SECRET=dev_fiat_webhook_secret
SETTLEMENT_INGRESS_SECRET=dev_settlement_ingress_secret
HMAC_SECRET=dev_hmac_secret

RAMP_API_KEY=dev_ramp_api_key
INVESTEC_CLIENT_ID=dev_investec_client_id
INVESTEC_SECRET=dev_investec_secret
ALCHEMY_PAY_APP_ID=dev_alchemy_pay_app_id
ALCHEMY_PAY_SECRET=dev_alchemy_pay_secret
BANXA_API_KEY=dev_banxa_api_key
BANXA_SECRET=dev_banxa_secret
INFOBIP_API_KEY=dev_infobip_api_key
