# Conxian Sandbox Environment Variables
# Copy this file to .env and fill in values

# PostgreSQL Configuration
POSTGRES_DB=conxian
POSTGRES_USER=conxian
# Path to a local, untracked file containing the database credential.
DB_CREDENTIAL_FILE=./.secrets/postgres_password
# Required connection URL for Nexus and Gateway; set this only in the local .env.
DB_CONNECTION_URL=

# Redis Configuration
REDIS_URL=redis://redis:6379

# Optional: Bitcoin RPC (for gateway)
# BITCOIN_RPC_URL=https://bitcoin-testnet.publicnode.com
