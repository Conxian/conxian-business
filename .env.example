# Conxian-Business Environment Configuration
# For internal secret provisioning guidance, use the Conxian GitHub organization/issues:
# https://github.com/Conxian

# Control-plane database and authentication
DATABASE_URL=postgresql://user:password@host/database
BETTER_AUTH_SECRET=<generate-a-random-32-byte-secret>
BETTER_AUTH_URL=http://localhost:3000

# Admin runtime: provision the Nexus origin and scoped credentials per environment.
# The SDK appends /admin/v1; do not include that path in the origin.
CONXIAN_ADMIN_RUNTIME_BASE_URL=
# api.read scope; never prefix credentials with NEXT_PUBLIC_.
CONXIAN_ADMIN_RUNTIME_READ_TOKEN=
# admin.write scope; provision only when workflow mutations are enabled.
CONXIAN_ADMIN_RUNTIME_WRITE_TOKEN=

# Stacks Private Key for operational scripts (e.g., scripts/register-sbcs.ts)
# Uncomment and set in your local .env (never commit real keys):
# STX_PRIVATE_KEY=<your_stacks_private_key_here>
